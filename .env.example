# Postgres (Neon): pooled URL for the app, direct URL for migrations
DATABASE_URL=
DIRECT_DATABASE_URL=
# Optional: connections per process (1-50, default 10). Keep small on Vercel; raise for a busy worker.
DATABASE_POOL_MAX=

# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Trigger.dev
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# OpenRouter (free route only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Magica (server-side only)
MAGICA_API_KEY=
MAGICA_BASE_URL=https://inference.magica.com

# Transloadit (Community plan)
TRANSLOADIT_KEY=
TRANSLOADIT_SECRET=

# Backblaze B2 (S3-compatible, private bucket) — durable asset storage
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=
B2_REGION=

# CORS: the deployed frontend origin
FRONTEND_ORIGIN=http://localhost:3000
